BREVO_API_KEY=your-brevo-api-key
PORT=3000
# Comma-separated origins for CORS, or * for any (less secure)
ALLOWED_ORIGINS=*

# Cloudflare Turnstile (https://dash.cloudflare.com/?to=/:account/turnstile)
TURNSTILE_SITE_KEY=your-turnstile-site-key
TURNSTILE_SECRET_KEY=your-turnstile-secret-key
# Or use TURNSTILE=secret-key only (legacy) with TURNSTILE_SITE_KEY for the widget

# Optional: copy to .env.local for secrets (loaded after .env, overrides)
